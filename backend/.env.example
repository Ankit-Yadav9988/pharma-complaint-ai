# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/pharma_complaints

# --- Groq LLM -------------------------------------------------------------
# Create a key at https://console.groq.com/keys
# Leave blank to run the app on the deterministic heuristic fallback engine.
GROQ_API_KEY=
# NOTE: gemma2-9b-it (the model named in the brief) was decommissioned by Groq.
# llama-3.1-8b-instant is its recommended successor for fast structured extraction.
GROQ_EXTRACTION_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# --- App ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
